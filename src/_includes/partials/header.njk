<header class="site-header">
  <div class="wrap header-row">
    <a href="/" class="brand" aria-label="Cultivate Local home">
      <img src="/assets/img/cultivate-logo.webp" alt="Cultivate Local food marketing" width="400" height="223">
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle-bars" aria-hidden="true"></span>
      <span class="nav-toggle-label">Menu</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {%- for item in site.nav %}
        <li><a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
        <li class="nav-cta"><a class="btn btn-small" href="/book/"{% if page.url.startsWith('/book/') %} aria-current="page"{% endif %}>Book a call</a></li>
      </ul>
    </nav>
  </div>
</header>
