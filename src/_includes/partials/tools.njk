<div class="tools">
  <div class="badges">
    {# Swap these for the official badge files from your Shopify Partner and Klaviyo partner dashboards:
       save them as /assets/img/badges/shopify-partner.svg and /assets/img/badges/klaviyo-partner.svg
       and set the flags in _data/badges.js to true. #}
    {% if badges.shopify %}
      <span class="badge-slot"><img src="/assets/img/badges/{{ badges.shopify }}" alt="Shopify Partner" width="160" height="40"></span>
    {% else %}
      <span class="badge-slot"><span class="badge-mark" aria-hidden="true"></span>Shopify Partner</span>
    {% endif %}
    {% if badges.klaviyo %}
      <span class="badge-slot"><img src="/assets/img/badges/{{ badges.klaviyo }}" alt="Klaviyo Partner" width="160" height="40"></span>
    {% else %}
      <span class="badge-slot"><span class="badge-mark" aria-hidden="true"></span>Klaviyo Partner</span>
    {% endif %}
  </div>
  <div>
    <h2 class="h-quiet" style="font-size:1.25rem;margin:0">Tools I work with</h2>
    <ul class="tool-names">
      <li>Shopify</li><li>Square</li><li>Barn2Door</li><li>GrazeCart</li><li>Mailchimp</li><li>Klaviyo</li><li>Google Ads</li><li>Meta Ads</li>
    </ul>
  </div>
</div>
