<section class="closer" aria-labelledby="closer-title">
  <div class="wrap closer-grid">
    <div>
      <h2 id="closer-title">Let's talk about your farm.</h2>
      <p>Calls are {{ site.hours }}. Or call or text <a href="tel:{{ site.phoneTel }}">{{ site.phone }}</a>, or email <a href="mailto:{{ site.email }}">{{ site.email }}</a>.</p>
    </div>
    <div class="closer-actions">
      <a class="btn btn-light" href="/book/">Book a free call</a>
      <a class="btn btn-corn" href="/self-check/">Take the free self-check</a>
    </div>
  </div>
</section>
